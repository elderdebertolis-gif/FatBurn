{
  "expo": {
    "name": "FatBurn",
    "slug": "fatburn",
    "version": "1.0.0",
    "icon": "./assets/branding/app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/branding/logo-horizontal-dark.png",
      "resizeMode": "contain",
      "backgroundColor": "#F2F2F2"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.elderdebertolis.fatburn",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-foreground.png",
        "monochromeImage": "./assets/branding/adaptive-monochrome.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "6a4417e9-41f1-47bb-8ab4-1b113fc10f52"
      }
    },
    "owner": "elder.debertolis"
  }
}
